# ── AWS (required when LLM_PROVIDER=bedrock) ──────────────────────────────────
AWS_REGION=us-west-2
# AWS_PROFILE=default           # optional: named profile from ~/.aws/credentials

# ── LLM provider ──────────────────────────────────────────────────────────────
# Supported: bedrock | openai | ollama
LLM_PROVIDER=bedrock
# LLM_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ── Embedding provider ────────────────────────────────────────────────────────
# Supported: huggingface | openai | ollama
EMBED_PROVIDER=huggingface
# EMBED_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5

# ── Vector store ──────────────────────────────────────────────────────────────
# Defaults to <project-root>/data-sources and <project-root>/vector-store
# DATA_SOURCES_DIR=/absolute/path/to/pdfs
# WEAVIATE_PERSIST_DIR=/absolute/path/to/vector-store/weaviate_langchain

# ── Retrieval backend ─────────────────────────────────────────────────────────
# Supported:
#   weaviate_langchain         -> Weaviate + LangChain hybrid retriever
#   llamaindex_sentence_window -> LlamaIndex sentence-window retriever
RETRIEVAL_BACKEND=weaviate_langchain

# LlamaIndex sentence-window settings (used only when RETRIEVAL_BACKEND=llamaindex_sentence_window)
# LLAMAINDEX_PERSIST_DIR=/absolute/path/to/vector-store/llamaindex_sentence_window
# SENTENCE_WINDOW_SIZE=3
SENTENCE_WINDOW_RERANK_ENABLED=true
SENTENCE_WINDOW_RERANK_MODEL=BAAI/bge-reranker-base
SENTENCE_WINDOW_RERANK_TOP_N=3


# OPENAI_API_KEY=sk-...

# ── Ollama (required when using ollama provider) ──────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434

# ── Observability ─────────────────────────────────────────────────────────────
PHOENIX_ENABLED=true
PHOENIX_PORT=6006

# ── TruLens Evaluation (optional — only needed for chatbot/eval/run_evaluation.py) ──
# TruLens uses AWS Bedrock (same credentials as the chatbot) for LLM-as-judge scoring.
# DB path for evaluation results (SQLite). Defaults to chatbot/eval/trulens.db
# TRULENS_DB_URL=sqlite:///chatbot/eval/trulens.db

# ── TruLens PROD Tracing (optional — monitors live traffic in the running chatbot) ──
# Set to true to record every chat turn to the TruLens DB for quality monitoring.
# View results: python -m chatbot.eval.run_evaluation --dashboard-only
# TRULENS_PROD_ENABLED=false
#
# Set to true to also score every live turn with RAG Triad metrics (async Bedrock judge).
# Adds ~5–10s background latency per turn. Only effective when TRULENS_PROD_ENABLED=true.
# TRULENS_PROD_FEEDBACK=false
#
# Optional: label this deployment's runs in the dashboard (default: "prod")
# APP_VERSION=prod

# ── Logging ───────────────────────────────────────────────────────────────────
# Supported: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Other Langchain config (optional) ─────────────────────────────────────────
# LANGCHAIN_API_KEY=lsv2_pt_***************************
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://apac.api.smith.langchain.com
# LANGCHAIN_PROJECT=langchain-chat-with-data
