# ── AWS / Bedrock ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Authentication — use ONE of the following:
#   1. A named profile from ~/.aws/credentials
AWS_PROFILE=
#   2. Explicit keys (used only when AWS_PROFILE is empty)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Models (bare Bedrock IDs, no aws: prefix) ─────────────────────────────────
AGENT_MODEL=us.anthropic.claude-sonnet-4-6
# TRIAGE_MODEL defaults to AGENT_MODEL if unset
TRIAGE_MODEL=
EMBED_MODEL=amazon.titan-embed-text-v2:0
# EMBED_MODEL=us.cohere.embed-v4:0  # requires AWS Marketplace subscription

# ── Memory / agent loop ───────────────────────────────────────────────────────
MEMORY_DB_DIR=./memory_db
MAX_AGENT_ITERATIONS=10
