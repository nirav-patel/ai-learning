# ─── LLM ───────────────────────────────────────────────────────────────────────
# OpenAI API key (required for all agents + image generation)
OPENAI_API_KEY=sk-...

# ─── Web Search ────────────────────────────────────────────────────────────────
# Tavily search API key (required for MarketResearchAgent)
TAVILY_API_KEY=tvly-...

# Optional: override Tavily base URL (e.g. for DLAI sandbox)
# DLAI_TAVILY_BASE_URL=https://...

# ─── Model Config (optional overrides) ─────────────────────────────────────────
# Default model used by all agents via aisuite
# AGENT_MODEL=openai:gpt-4o-mini

# Image generation model (OpenAI images API)
# IMAGE_MODEL=dall-e-3

# Image size: 1024x1024 | 1792x1024 | 1024x1792
# IMAGE_SIZE=1024x1024

# ─── Pipeline Config ───────────────────────────────────────────────────────────
# Directory where output files (images, reports) are saved
# OUTPUT_DIR=./output
