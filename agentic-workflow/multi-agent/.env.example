# ─── AWS Credentials ──────────────────────────────────────────────────────────
# Option 1: explicit keys (recommended for local dev)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Option 2: use a named profile from ~/.aws/credentials
# AWS_PROFILE=my-bedrock-profile

# AWS region where your Bedrock models are enabled
AWS_REGION=us-east-1

# ─── Web Search ────────────────────────────────────────────────────────────────
# Tavily search API key (required for MarketResearchAgent)
TAVILY_API_KEY=tvly-...

# Optional: override Tavily base URL (e.g. for DLAI sandbox)
# DLAI_TAVILY_BASE_URL=https://...

# ─── Model Config (optional overrides) ─────────────────────────────────────────
# Text agent model via aisuite  (aws:<bedrock-model-id>)
# AGENT_MODEL=aws:us.anthropic.claude-sonnet-4-6

# Multimodal model for CopywriterAgent (bare Bedrock model ID, no "aws:" prefix)
# COPYWRITER_MODEL=us.anthropic.claude-sonnet-4-6

# Image generation model (Amazon Titan Image Generator on Bedrock)
# IMAGE_MODEL=amazon.titan-image-generator-v2:0

# Image size in WxH format (Titan supports 256–2048 in multiples of 64)
# IMAGE_SIZE=1024x1024

# ─── Pipeline Config ───────────────────────────────────────────────────────────
# Directory where output files (images, reports) are saved
# OUTPUT_DIR=./output
